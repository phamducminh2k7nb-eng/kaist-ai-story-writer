# GEMINI_API_KEY: Required for Gemini AI API calls.
# Create a NEW Auth API Key in Google AI Studio and store it only as a Railway secret.
# Do not commit real keys. Standard legacy keys may be rejected by Gemini API in Sep 2026.
GEMINI_API_KEY=""

# OPENAI_API_KEY: Optional. For connecting OpenAI models (GPT-4o, GPT-4o-mini).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# POLLINATIONS_API_KEY: Optional image-generation fallback.
# Create a server-side key at enter.pollinations.ai and keep it in Secrets.
# Never expose an sk_ key in frontend code.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# ANTHROPIC_API_KEY: Optional. For connecting Anthropic Claude models (Claude 3.5 Sonnet).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: Public production URL.
APP_URL="https://kaist-ai-story-writer-production.up.railway.app"

# GOOGLE_CLIENT_ID: Optional. Google Sign-In stays hidden when this is empty.
# If enabled, add APP_URL exactly to Authorized JavaScript Origins in Google Cloud Console.
GOOGLE_CLIENT_ID=""


# Optional: connect KAIST Publisher Agent to your own website/CMS.
# When configured, approved/queued chapters can be POSTed automatically as JSON.
PUBLISH_WEBHOOK_URL=""
PUBLISH_WEBHOOK_TOKEN=""